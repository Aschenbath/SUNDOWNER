{
  "name": "sundowner",
  "version": "2.6.4",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "ci-test": "concurrently --kill-others \"npm start\" \"wait-on http://localhost:8787 && mocha\"",
    "ci-test:docker": "concurrently --kill-others \"npm run start:docker\" \"wait-on http://localhost:8787 && mocha\"",
    "test": "mocha",
    "test:docs": "mocha test/publicDocsContract.test.js test/readmeScreenshotWorkflow.test.js",
    "start": "npx wrangler pages dev ./ --kv \"img_url\" --d1 \"img_d1\" --r2 \"img_r2\" --ip 0.0.0.0 --port 8787 --persist-to ./.local/data",
    "start:docker": "D:/DevTools/nvm/v22.14.0/node.exe --import ./server/register.mjs server/index.js",
    "install": "npm --prefix ./functions install --no-package-lock --progress=false",
    "capture:readme": "node scripts/capture-readme-screenshots.mjs",
    "capture:readme:local": "powershell -ExecutionPolicy Bypass -File scripts/capture-readme-screenshots.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.726.1",
    "@cloudflare/pages-plugin-sentry": "^1.1.3",
    "@hono/node-server": "^1.13.8",
    "@sentry/tracing": "^7.114.0",
    "better-sqlite3": "^11.9.1",
    "exifr": "^7.1.3",
    "hono": "^4.7.4"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.6",
    "serialize-javascript": "^7.0.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "miniflare": "^4.20260701.0",
    "mocha": "^10.6.0",
    "wait-on": "^7.2.0",
    "wrangler": "^4.24.0"
  }
}
